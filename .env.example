# Careers Admin Frontend – copy to .env and set for your environment
# For production/staging builds, set these in your deployment (e.g. CapRover env / build args).

# Backend API base URL (required for production — baked in at build time)
# VITE_API_BASE_URL=https://trizen-careers-backend.llp.trizenventures.com

# Optional: local dev overrides (defaults: http://localhost:5000 if unset in dev)
VITE_API_BASE_URL=http://localhost:5000

# Email service (required for Bulk Email / notifications in production)
VITE_EMAIL_SERVICE_URL=https://trizen-support-email-service.llp.trizenventures.com
# VITE_EMAIL_SERVICE_API_KEY=your-key
